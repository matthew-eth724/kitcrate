{
  "name": "kitcrate",
  "version": "0.1.0",
  "description": "Collections layer on top of the skills CLI \u2014 install, update, and remove collections of agent skills from git repos.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kitcrate": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/core": "^1.6.0",
    "@clack/prompts": "^1.9.0",
    "skills": "^1.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
